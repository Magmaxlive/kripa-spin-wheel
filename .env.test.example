# Copy to .env.test and fill in staging-only values.
# DO NOT commit .env.test. DO NOT point this at production.

# Base URL of the running Next.js app under test.
E2E_BASE_URL=http://localhost:3000

# Credentials for a staging-only admin seeded in auth.users + admins.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Phone-number prefix used to seed throwaway test participants.
# Choose something your staging data can safely contain and delete.
E2E_TEST_PHONE_PREFIX=+640000

# Set to 1 if you want Playwright to start `npm run dev` automatically.
# Leave unset to point tests at an already-running server.
E2E_START_DEV=
